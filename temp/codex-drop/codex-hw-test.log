+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+
+ROOT = Path(__file__).resolve().parent
+CANVAS_SIZE = (3600, 2800)
+MARGIN = 80
+GAP = 48
+COLS = 3
+ROWS = 3
+
+
+def font(size: int, bold: bool = False) -> ImageFont.FreeTypeFont:
+    name = "DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"
+    return ImageFont.truetype(f"/usr/share/fonts/truetype/dejavu/{name}", size)
+
+
+items = [
+    ("1 — LAPTOP (use this complete laptop)", "laptop.jpg", (0, 0, 512, 512)),
+    ("2 — INTEL CPU PACKAGE", "cpu.jpg", None),
+    ("3 — DDR2 RAM MODULE", "ram.jpg", None),
+    ("4 — SN74S181N ALU", "alu-74181.jpg", None),
+    ("5 — MOTOROLA MC68451 MMU", "mmu-mc68451.jpg", None),
+    ("6 — PCI / PCI-E SLOTS (BUS)", "bus-pcie.jpg", None),
+    ("7 — HYUNDAI HY6116AP SRAM (CACHE)", "cache-sram.jpg", None),
+]
+
+canvas = Image.new("RGB", CANVAS_SIZE, "white")
+draw = ImageDraw.Draw(canvas)
+title_font = font(62, bold=True)
+label_font = font(38, bold=True)
+draw.text((MARGIN, 28), "SOURCE HARDWARE — preserve each photographed item exactly", fill="#111827", font=title_font)
+
+top = 130
+cell_w = (CANVAS_SIZE[0] - 2 * MARGIN - (COLS - 1) * GAP) // COLS
+cell_h = (CANVAS_SIZE[1] - top - MARGIN - (ROWS - 1) * GAP) // ROWS
+
+for index, (label, filename, crop) in enumerate(items):
+    row, col = divmod(index, COLS)
+    x = MARGIN + col * (cell_w + GAP)
+    y = top + row * (cell_h + GAP)
+    draw.rounded_rectangle((x, y, x + cell_w, y + cell_h), radius=24, fill="#F8FAFC", outline="#CBD5E1", width=4)
+    image = Image.open(ROOT / filename).convert("RGB")
+    if crop:
+        image = image.crop(crop)
+    label_h = 78
+    inner_w = cell_w - 44
+    inner_h = cell_h - label_h - 42
+    image.thumbnail((inner_w, inner_h), Image.Resampling.LANCZOS)
+    ix = x + (cell_w - image.width) // 2
+    iy = y + label_h + (inner_h - image.height) // 2
+    canvas.paste(image, (ix, iy))
+    draw.text((x + 24, y + 18), label, fill="#0F172A", font=label_font)
+
+canvas.save(ROOT / "reference-sheet.png", quality=95)

