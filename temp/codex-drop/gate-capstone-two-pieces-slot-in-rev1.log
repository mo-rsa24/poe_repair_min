+  }
+
+  draw_bracket(cr,sx[0],ex[4],341,"the floor");
+  draw_bracket(cr,sx[5],ex[9],341,"the run");
+  draw_bracket(cr,sx[10],ex[13],341,"what a sampler may be");
+  draw_bracket(cr,sx[14],ex[16],341,"both errors");
+  draw_bracket(cr,sx[17],ex[21],341,"continuous time");
+  draw_bracket(cr,sx[22],ex[24],341,"correctors");
