+  draw_bracket(cr,sx[10],ex[13],341,"what a sampler may be");
+  draw_bracket(cr,sx[14],ex[16],341,"both errors");
+  draw_bracket(cr,sx[17],ex[21],341,"continuous time");
+  draw_bracket(cr,sx[22],ex[24],341,"correctors");
+  draw_bracket(cr,sx[25],ex[27],341,"annealing");
+  draw_bracket(cr,sx[28],ex[29],341,"the judgment");
+
+  /* Rejoin the preserved lower leaders at their original x coordinates. */
+  cairo_set_line_width(cr,1.8);
+  cairo_set_source_rgb(cr,0.94,0.30,0.02);
+  cairo_move_to(cr,497,317); cairo_line_to(cr,497,395); cairo_stroke(cr);
+  cairo_set_source_rgb(cr,0.00,0.39,0.68);
+  cairo_move_to(cr,1260,317); cairo_line_to(cr,1260,395); cairo_stroke(cr);
+  cairo_set_source_rgb(cr,0.12,0.12,0.115);
+  cairo_move_to(cr,1608.5,351); cairo_line_to(cr,1608.5,395); cairo_stroke(cr);
+
+  cairo_destroy(cr);
+  int rc=cairo_surface_write_to_png(s,argv[2]);
+  cairo_surface_destroy(s);
+  if(rc){ fprintf(stderr,"failed to write png: %d\n",rc); return 5; }
+  return 0;
+}

