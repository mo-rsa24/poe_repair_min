+extern int cairo_surface_write_to_png(cairo_surface_t *surface, const char *filename);
+extern void cairo_surface_destroy(cairo_surface_t *surface);
+extern cairo_t *cairo_create(cairo_surface_t *target);
+extern void cairo_destroy(cairo_t *cr);
+extern void cairo_set_source_rgb(cairo_t *cr, double red, double green, double blue);
+extern void cairo_set_source_surface(cairo_t *cr, cairo_surface_t *surface, double x, double y);
+extern void cairo_paint(cairo_t *cr);
+extern void cairo_scale(cairo_t *cr, double sx, double sy);
+extern void cairo_set_line_width(cairo_t *cr, double width);
+extern void cairo_rectangle(cairo_t *cr, double x, double y, double width, double height);
+extern void cairo_fill(cairo_t *cr);
+extern void cairo_move_to(cairo_t *cr, double x, double y);
+extern void cairo_line_to(cairo_t *cr, double x, double y);
+extern void cairo_curve_to(cairo_t *cr, double x1, double y1, double x2, double y2, double x3, double y3);
+extern void cairo_arc(cairo_t *cr, double xc, double yc, double radius, double angle1, double angle2);
+extern void cairo_close_path(cairo_t *cr);
+extern void cairo_new_path(cairo_t *cr);
+extern void cairo_stroke(cairo_t *cr);
+extern void cairo_select_font_face(cairo_t *cr, const char *family, int slant, int weight);
+extern void cairo_set_font_size(cairo_t *cr, double size);
+extern void cairo_text_extents(cairo_t *cr, const char *utf8, cairo_text_extents_t *extents);
+extern void cairo_show_text(cairo_t *cr, const char *utf8);
+
+typedef struct {
+  double width;
+  int accent; /* 0 neutral, 1 warm, 2 cool */
+  int nlines;
+  const char *line[5];
+} Tile;
+
+static const double PI = 3.14159265358979323846;
+
+static void rounded_rect(cairo_t *cr, double x, double y, double w, double h, double r) {
+  cairo_new_path(cr);
+  cairo_arc(cr, x+w-r, y+r, r, -PI/2, 0);
+  cairo_arc(cr, x+w-r, y+h-r, r, 0, PI/2);
+  cairo_arc(cr, x+r, y+h-r, r, PI/2, PI);
+  cairo_arc(cr, x+r, y+r, r, PI, 3*PI/2);
+  cairo_close_path(cr);
+}
+
+static void centered_text(cairo_t *cr, const char *s, double cx, double baseline) {
+  cairo_text_extents_t e;
+  cairo_text_extents(cr, s, &e);
+  cairo_move_to(cr, cx - (e.width/2.0 + e.x_bearing), baseline);
+  cairo_show_text(cr, s);
+}
+
+static void draw_tile(cairo_t *cr, const Tile *t, double x, double y, double h) {
+  rounded_rect(cr, x, y, t->width, h, 4.0);
+  cairo_set_source_rgb(cr, 0.975, 0.975, 0.972);
+  cairo_fill(cr);
+  rounded_rect(cr, x, y, t->width, h, 4.0);
+  if (t->accent == 1) cairo_set_source_rgb(cr, 0.94, 0.30, 0.02);
+  else if (t->accent == 2) cairo_set_source_rgb(cr, 0.00, 0.39, 0.68);
+  else cairo_set_source_rgb(cr, 0.55, 0.55, 0.54);
+  cairo_set_line_width(cr, t->accent ? 1.8 : 1.15);
+  cairo_stroke(cr);
+
+  cairo_set_source_rgb(cr, 0.07, 0.07, 0.065);
+  cairo_select_font_face(cr, "DejaVu Sans Condensed", 0, 1);
+  double fs = t->accent ? 9.6 : 8.7;
+  cairo_set_font_size(cr, fs);
+  double maxw = 0.0;
+  for (int i=0; i<t->nlines; i++) {
+    cairo_text_extents_t e;
+    cairo_text_extents(cr, t->line[i], &e);
+    if (e.width > maxw) maxw = e.width;
+  }
+  if (maxw > t->width-5.0) {
+    fs *= (t->width-5.0)/maxw;
+    if (fs < 6.0) fs = 6.0;
+    cairo_set_font_size(cr, fs);
+  }
+  double lh = fs * 1.32;
+  double total = (t->nlines - 1) * lh;
+  double first = y + h/2.0 - total/2.0 + fs*0.35;
+  for (int i=0; i<t->nlines; i++) centered_text(cr, t->line[i], x+t->width/2.0, first+i*lh);
+}
+
+static void draw_bracket(cairo_t *cr, double x1, double x2, double y, const char *label) {
+  double m=(x1+x2)/2.0;
+  cairo_set_source_rgb(cr, 0.17, 0.17, 0.16);
+  cairo_set_line_width(cr, 1.45);
+  cairo_new_path(cr);
+  cairo_move_to(cr, x1, y);
+  cairo_line_to(cr, x1, y+5);
+  cairo_curve_to(cr, x1, y+9, x1+3, y+10, x1+7, y+10);
+  cairo_line_to(cr, m-6, y+10);
+  cairo_curve_to(cr, m-2, y+10, m-2, y+14, m, y+16);
+  cairo_curve_to(cr, m+2, y+14, m+2, y+10, m+6, y+10);
+  cairo_line_to(cr, x2-7, y+10);
+  cairo_curve_to(cr, x2-3, y+10, x2, y+9, x2, y+5);
+  cairo_line_to(cr, x2, y);
+  cairo_stroke(cr);
+  cairo_select_font_face(cr, "DejaVu Sans Condensed", 0, 0);
+  cairo_set_font_size(cr, 16.0);
+  centered_text(cr, label, m, y+42);
+}
+
+int main(int argc, char **argv) {
+  if (argc != 3) { fprintf(stderr, "usage: %s input.png output.png\n", argv[0]); return 2; }
+  cairo_surface_t *base = cairo_image_surface_create_from_png(argv[1]);
+  if (!base || cairo_surface_status(base)) { fprintf(stderr, "failed to load input\n"); return 3; }
+  int W=cairo_image_surface_get_width(base), H=cairo_image_surface_get_height(base);
+  if (W != 1672 || H != 941) { fprintf(stderr, "unexpected dimensions %dx%d\n", W,H); return 4; }
+  cairo_surface_flush(base);
+  unsigned char *data=cairo_image_surface_get_data(base);
+  int stride=cairo_image_surface_get_stride(base);
+  uint32_t p=*(uint32_t *)(data + 100*stride + 800*4);
+  double br=((p>>16)&255)/255.0, bg=((p>>8)&255)/255.0, bb=(p&255)/255.0;
+
+  cairo_surface_t *s=cairo_image_surface_create(0,W*2,H*2);
+  if (!s || cairo_surface_status(s)) { fprintf(stderr, "failed to create output\n"); return 4; }
+  cairo_t *cr=cairo_create(s);
+  cairo_scale(cr,2.0,2.0);
+  cairo_set_source_surface(cr,base,0,0);
+  cairo_paint(cr);
+  cairo_set_source_rgb(cr, br,bg,bb);
+  cairo_rectangle(cr,0,0,W,395);
+  cairo_fill(cr);
+
+  cairo_set_source_rgb(cr,0.045,0.045,0.043);
+  cairo_select_font_face(cr,"DejaVu Sans",0,1);
+  cairo_set_font_size(cr,39.0);
+  cairo_move_to(cr,22,63);
+  cairo_show_text(cr,"two pieces slot in, nothing reorders");
+
+  /* Legend */
+  cairo_select_font_face(cr,"DejaVu Sans Condensed",0,1);
+  cairo_set_font_size(cr,24.0);
+  cairo_move_to(cr,1360,43); cairo_show_text(cr,"legend");
+  const char *ll[3]={"existing stage","Tweedie insertion","flow insertion"};
+  int la[3]={0,1,2};
+  for(int i=0;i<3;i++){
+    double yy=57+i*42;
+    rounded_rect(cr,1360,yy,58,31,5);
+    cairo_set_source_rgb(cr,0.975,0.975,0.972); cairo_fill(cr);
+    rounded_rect(cr,1360,yy,58,31,5);
+    if(la[i]==1)cairo_set_source_rgb(cr,0.94,0.30,0.02);
+    else if(la[i]==2)cairo_set_source_rgb(cr,0.00,0.39,0.68);
+    else cairo_set_source_rgb(cr,0.55,0.55,0.54);
+    cairo_set_line_width(cr,la[i]?1.8:1.15); cairo_stroke(cr);
+    cairo_set_source_rgb(cr,0.07,0.07,0.065);
+    cairo_select_font_face(cr,"DejaVu Sans Condensed",0,1);
+    cairo_set_font_size(cr,16.5);
+    cairo_move_to(cr,1434,yy+22); cairo_show_text(cr,ll[i]);
+  }
+
+  Tile t[30]={
+    {45,0,2,{"log","density"}},
+    {56,0,3,{"the","gradient","as a field"}},
+    {64,0,3,{"the score","of a","Gaussian"}},
+    {46,0,2,{"energy","and Z"}},
+    {56,0,2,{"Gaussian","integrals"}},
+    {57,0,3,{"the","forward","process"}},
+    {50,0,3,{"one","reverse","step"}},
+    {63,0,3,{"noise","prediction is","the score"}},
+    {72,1,4,{"Tweedie:","eps, score,","posterior","mean"}},
+    {44,0,3,{"the","PoE","rule"}},
+    {52,0,3,{"a","Markov","chain"}},
+    {52,0,2,{"detailed","balance"}},
+    {62,0,2,{"Metropolis-","Hastings"}},
+    {62,0,2,{"unnormalised","is enough"}},
+    {58,0,3,{"the two-","Gaussian","toy"}},
+    {60,0,3,{"gap_mu","and","gap_Sigma"}},
+    {68,0,3,{"which gap","a corrector","removes"}},
+    {52,0,2,{"Brownian","motion"}},
+    {40,0,2,{"Ito","lemma"}},
+    {52,0,2,{"Fokker-","Planck"}},
+    {64,0,2,{"Ornstein-","Uhlenbeck"}},
+    {70,2,3,{"probability","flow ODE","+ DDIM"}},
+    {42,0,2,{"Langevin","dynamics"}},
+    {40,0,2,{"predictor-","corrector"}},
+    {43,0,2,{"Hamiltonian","corrector"}},
+    {38,0,2,{"what is","annealed"}},
+    {45,0,3,{"annealed","importance","sampling"}},
+    {47,0,3,{"Feynman-","Kac","correctors"}},
+    {55,0,4,{"a corrector","on the","cached","trajectories"}},
+    {32,0,2,{"the","verdict"}}
+  };
+
+  double x=8, y=212, th=105, gap=2;
+  double sx[30], ex[30];
+  for(int i=0;i<30;i++){
+    sx[i]=x; draw_tile(cr,&t[i],x,y,th); ex[i]=x+t[i].width; x=ex[i]+gap;
+  }
+
+  draw_bracket(cr,sx[0],ex[4],341,"the floor");
+  draw_bracket(cr,sx[5],ex[9],341,"the run");
+  draw_bracket(cr,sx[10],ex[13],341,"what a sampler may be");
+  draw_bracket(cr,sx[14],ex[16],341,"both errors");
+  draw_bracket(cr,sx[17],ex[21],341,"continuous time");
+  draw_bracket(cr,sx[22],ex[24],341,"correctors");
+  draw_bracket(cr,sx[25],ex[27],341,"annealing");
+  draw_bracket(cr,sx[28],ex[29],341,"the judgment");
+
+  /* Rejoin the preserved lower leaders at their original x coordinates. */
+  cairo_set_line_width(cr,1.8);
+  cairo_set_source_rgb(cr,0.94,0.30,0.02);
+  cairo_move_to(cr,497,317); cairo_line_to(cr,497,395); cairo_stroke(cr);
+  cairo_set_source_rgb(cr,0.00,0.39,0.68);
+  cairo_move_to(cr,1260,317); cairo_line_to(cr,1260,395); cairo_stroke(cr);
+  cairo_set_source_rgb(cr,0.12,0.12,0.115);
+  cairo_move_to(cr,1608.5,351); cairo_line_to(cr,1608.5,395); cairo_stroke(cr);
+
+  cairo_destroy(cr);
+  int rc=cairo_surface_write_to_png(s,argv[2]);
+  cairo_surface_destroy(s);
+  cairo_surface_destroy(base);
+  if(rc){ fprintf(stderr,"failed to write png: %d\n",rc); return 5; }
+  return 0;
+}

