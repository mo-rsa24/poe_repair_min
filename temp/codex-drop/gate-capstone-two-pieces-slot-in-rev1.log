+  double fs = t->accent ? 9.6 : 8.7;
+  cairo_set_font_size(cr, fs);
+  double maxw = 0.0;
+  for (int i=0; i<t->nlines; i++) {
+    cairo_text_extents_t e;
+    cairo_text_extents(cr, t->line[i], &e);
+    if (e.width > maxw) maxw = e.width;
+  }
