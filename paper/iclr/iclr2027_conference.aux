\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The same rule composes one pair and blends another.} Columns are prompt pairs, both sampled with uncorrected product-of-experts composition. \textbf  {Top:} one real sample each, seed 42. \textbf  {Bottom:} $\|r_t\|$ as a fraction of $\|\hat  \epsilon _{\mathrm  {PoE}}\|$ at every denoising step, median over seeds 4, 42 and 123 with a min-to-max band, both panels on one $y$ axis.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:two-regimes}{{2}{5}{\textbf {The same rule composes one pair and blends another.} Columns are prompt pairs, both sampled with uncorrected product-of-experts composition. \textbf {Top:} one real sample each, seed 42. \textbf {Bottom:} $\|r_t\|$ as a fraction of $\|\hat \epsilon _{\mathrm {PoE}}\|$ at every denoising step, median over seeds 4, 42 and 123 with a min-to-max band, both panels on one $y$ axis}{figure.2}{}}
