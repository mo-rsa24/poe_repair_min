# Python bytecode and virtualenvs
*pycache*/
*.pyc
.venv/
venv/

# Training artifacts
*.npy
*.pt
*.safetensors
wandb/

# Pilot data (lives under /datasets/...)
dataset/

# Editor / IDE local state
claude/
.claude/*
# Shared project config is tracked: the hooks and the project skills are part of
# how this repo is worked, not personal editor state.
!.claude/settings.json
!.claude/skills/
.idea/
.vscode/local/

# Local results — symlinks point at /datasets/mmolefe/poe_repair_min/outputs/
outputs/*
!outputs/INDEX.md
logs/

# Generated run artifacts (regenerable; large; canonical copies live under /datasets/mmolefe).
# Source content that lives under artifacts/ by the four-folder convention (drips, scenes,
# notes, decks, videos, and their READMEs) is tracked; only the run-output kinds are ignored.
artifacts/results/
artifacts/caches/
artifacts/rung2-survive-noise/
artifacts/rung3-group-wise/
artifacts/rung4-scale/
artifacts/_quarantine/
results/

# Papers / reference PDFs (not source)
*.pdf

# Misc transient
.DS_Store
*.tmp
paper/*-overleaf*.zip

# Built scene apps: dist bundles and dependencies are regenerable from the source
# beside them (npm install && npm run build). The source is tracked; these are not.
artifacts/scenes/*/dist/
artifacts/scenes/*/node_modules/
artifacts/scenes/*/app/dist/
artifacts/scenes/*/app/node_modules/

# Codex render attempts and transcripts land here per render-diagrams; the folder is
# disposable by convention and only passing images are copied out to a diagrams/ path.
temp/

# The Overleaf project's git bridge, cloned as its own repository. It is a
# transfer point between paper/iclr and Overleaf, not a second workspace, and
# it carries a history the project repo must not nest inside its own.
# paper/overleaf-iclr/
